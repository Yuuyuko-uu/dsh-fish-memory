{
  "name": "fish-companion-memory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Standalone companion memory service: validated contracts and persistent runtime foundation.",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "schemas:write": "node scripts/export-schemas.ts",
    "schemas:check": "node scripts/export-schemas.ts --check",
    "test": "node --test tests/*.test.ts",
    "cli": "node src/cli.ts",
    "build": "node scripts/build.ts",
    "start": "node dist/cli.js serve",
    "smoke:built": "node scripts/smoke-built.ts",
    "check": "npm run typecheck && npm run schemas:check && npm test && npm run build && npm run smoke:built"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "7.0.2" }
}
