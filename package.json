{
  "name": "dsh-fish-memory",
  "version": "1.4.7",
  "description": "给 DSH 里的会话一份会淡忘的长期记忆，每条都带时间。",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "ai-companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuuyuko-uu/dsh-fish-memory.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
